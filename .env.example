# fixora-diagnostic-orchestrator-agent environment template.
# Copy to .env and fill in real values. Never commit .env itself (gitignored).

HOST=0.0.0.0
PORT=8092

# --- Data sources for diagnostic (read-only) agents ---
GRAFANA_BASE_URL=http://localhost:3000
GRAFANA_API_KEY=REPLACE_WITH_YOUR_KEY

KIBANA_BASE_URL=http://localhost:5601
KIBANA_API_KEY=REPLACE_WITH_YOUR_KEY

# --- KibanaAgent (Deep Analysis phase 1) ---
# KibanaAgent talks to Elasticsearch through the Elastic MCP server, which it
# spawns itself as a stdio subprocess (npx @elastic/mcp-server-elasticsearch)
# -- see mcp_clients/elastic_mcp_client.py. Requires Node.js/npx on this host.
ELASTIC_URL=http://localhost:9201
KIBANA_LOG_INDEX=fixora-app-logs

OTEL_COLLECTOR_URL=http://localhost:4318

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

KUBE_CONFIG_PATH=~/.kube/config

# --- Evidence store ---
POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/fixora
OBJECT_STORAGE_URL=
VECTOR_DB_URL=
